<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.android.bluetooth.bthelper.adapter"
    android:versionCode="1"
    android:versionName="1.0">

    <queries>
        <package android:name="com.android.bluetooth.bthelper" />
    </queries>

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />

    <permission
        android:name="com.android.bluetooth.bthelper.adapter.permission.SET_SLICE"
        android:protectionLevel="signature" />

    <attribution
        android:tag="BtHelperAdapter"
        android:label="@string/app_name" />

    <application
        android:icon="@mipmap/ic_bthelper"
        android:label="@string/app_name">

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.android.bluetooth.bthelper.adapter.androidx-startup"
            tools:replace="android:authorities" />

        <provider
            android:authorities="com.android.bluetooth.bthelper.sliceprovider"
            android:name=".slices.BtHelperSliceProvider"
            android:grantUriPermissions="true"
            android:exported="true" />

        <receiver
            android:name=".StartupReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.android.bluetooth.bthelper.adapter.permission.SET_SLICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="com.android.bluetooth.bthelper.SET_SLICE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
